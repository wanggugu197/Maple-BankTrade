/* ========== 右页银行网格与分页 ========== */

.mbt-bank-list {
  width: 126;
  height: 75;
  flex-direction: row;
  flex-wrap: wrap;
  align-content: space-between;
  justify-content: space-around;
  background: empty;
}

/* 槽位外壳 40×36，padding 2（与 BankInfo 按钮 inset 一致） */
.mbt-bank-slot {
  width: 40;
  height: 36;
  padding-all: 2;
}

.mbt-bank-slot-button {
  width: 36;
  height: 32;
  base-background: empty;
  hover-background: empty;
  pressed-background: empty;
  padding-all: 0;
}

.mbt-bank-turn-page {
  width: 64;
  height: 4;
  flex-direction: row;
  justify-content: space-evenly;
  align-items: center;
}

.mbt-bank-page-label {
  width: auto;
  height: auto;
  font-size: 2;
  horizontal-align: center;
  vertical-align: center;
  text-shadow: false;
}

.mbt-bank-page-button {
  width: auto;
  height: auto;
  base-background: empty;
  hover-background: empty;
  pressed-background: empty;
  padding-all: 0;
}

.mbt-bank-page-button > text:internal,
.mbt-bank-page-button .__button_text__ {
  font-size: 2;
  horizontal-align: center;
  vertical-align: center;
  text-shadow: false;
}
